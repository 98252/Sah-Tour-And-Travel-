# SAH TOUR AND TRAVEL - Environment Configuration Template
# CRITICAL SECURITY RULE: Never commit genuine secrets or production keys to version control.
# Copy this template to .env.local or production secrets vault.

# Database URL
DATABASE_URL="file:./dev.db"

# Public Application URL
NEXT_PUBLIC_SITE_URL="https://www.sahtourandtravel.com"

# Razorpay Payment Gateway Credentials (Phase 9)
# Public Key ID (Safe to expose to browser client)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_replace_with_your_key_id"
RAZORPAY_KEY_ID="rzp_test_replace_with_your_key_id"

# PRIVATE Secret Key (NEVER expose to client, NEVER prefix with NEXT_PUBLIC_)
RAZORPAY_KEY_SECRET="replace_with_your_private_key_secret"

# Email Delivery Provider (Resend)
# PRIVATE API Key
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Sah Tour And Travel <onboarding@resend.dev>"
CONTACT_INQUIRY_EMAIL="inquiry@sahtourandtravel.com"
